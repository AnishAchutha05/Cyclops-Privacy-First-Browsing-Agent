# Cyclops Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── Provider API Keys ─────────────────────────────────────
# Only set keys for the providers you intend to use.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Custom / Self-hosted Provider ─────────────────────────
# Base URL for any OpenAI-compatible endpoint (e.g. Ollama, LM Studio)
CUSTOM_API_BASE_URL=
CUSTOM_API_KEY=

# ── Defaults (optional) ───────────────────────────────────
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o
