{
  "manifest_version": 3,
  "name": "Cyclops",
  "version": "1.0.0",
  "description": "Privacy-first visual browser agent",
  "action": {
    "default_popup": "index.html",
    "default_title": "Cyclops"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ]
}
